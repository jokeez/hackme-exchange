{
  "name": "hackme-exchange-demo",
  "private": true,
  "version": "0.1.0-demo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/cf_chunk_assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui-smoke": "vitest run src/ui.smoke.test.ts src/pro.features.test.ts",
    "test:viewport": "node scripts/multi_viewport_pass.mjs",
    "test:e2e": "node scripts/multi_viewport_pass.mjs && node scripts/full_ui_ux_pass.mjs && node scripts/b_chart_manual_pass.mjs && node scripts/convert_account_pass.mjs && node scripts/mega_ui_audit.mjs",
    "test:e2e:full": "bash scripts/run_all_e2e.sh",
    "test:mega": "node scripts/mega_ui_audit.mjs",
    "test:all": "vitest run",
    "dev:d1": "bash scripts/d1-local-dev.sh",
    "smoke:d1": "npx tsx scripts/d1-smoke.ts"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "playwright": "^1.55.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.8.0",
    "lightweight-charts": "^5.2.0"
  }
}
