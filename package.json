{
  "name": "hackme-exchange-demo",
  "private": true,
  "version": "0.1.0-demo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/cf_chunk_assets.mjs",
    "icons:gen": "python3 scripts/generate_pwa_icons.py",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui-smoke": "vitest run src/ui.smoke.test.ts src/pro.features.test.ts",
    "test:e2e": "node scripts/g10_visual_pass.mjs",
    "test:e2e:full": "node scripts/mega_ui_audit.mjs",
    "smoke:live": "node scripts/live_smoke.mjs",
    "dev:d1": "bash scripts/d1-local-dev.sh",
    "smoke:d1": "npx tsx scripts/d1-smoke.ts",
    "smoke:lab": "npx tsx scripts/lab-smoke.ts",
    "audit:full": "bash scripts/full_audit.sh",
    "d0:static": "bash scripts/prepare_d0_static.sh"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "playwright": "^1.55.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "lightweight-charts": "^5.2.1"
  },
  "license": "AGPL-3.0-or-later"
}
