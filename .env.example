# Integration mode: paper (default) | demo | lab | live
# paper/demo = local paper balances; lab = paper UI + loopback API wiring
# live = blocked for public (downgrades to paper). Do NOT enable for production.
VITE_INTEGRATION_MODE=paper

# D1 local staging (loopback API + Postgres) — npm run dev:d1
# VITE_INTEGRATION_MODE=staging
# VITE_LAB_API=1
# VITE_EXCHANGE_API_ORIGIN=http://127.0.0.1:18443

# --- Origins: keep localhost vs production explicit ---
# Public hub + oracle (production site; soft-fails offline → fallback mid)
# On exchange.hackme.tech leave unset — Caddy serves /hub-proxy and /pool-proxy.
# VITE_HUB_ORIGIN=https://hackme.tech
# Future static SPA origin (do NOT point public DNS here until launch)
VITE_EXCHANGE_ORIGIN=https://exchange.hackme.tech
# Pool coordinator oracle — leave unset on production exchange host (uses /pool-proxy).
# Dev-only override when not on exchange.hackme.tech:
# VITE_POOL_ORIGIN=https://hackme.tech/pool/coordinator

# Local hackme-node only (dashboard + GET /api/wallet). For public builds keep loopback
# so Sync / Node wallet links stay local; never put a public node URL with admin token.
VITE_NODE_ORIGIN=http://127.0.0.1:8080

# --- Private lab exchange-api (OPT-IN, loopback only) ---
# Uncomment to wire liveSettlement (server balances + matching). Paper stays default when unset.
# Does NOT flip isLiveMode() — public remains paper.
# Also enabled by VITE_LAB_API=1 or VITE_INTEGRATION_MODE=lab (defaults origin below).
# VITE_EXCHANGE_API_ORIGIN=http://127.0.0.1:18443
# VITE_LAB_API=1

# Optional — NEVER set any admin token in SPA builds. Vite inlines VITE_* into the browser.
# Admin auth is CLI / API process only (X-Admin-Token on loopback lab).
